FAKE_RUNTIME(swift_arrayAssignWithCopyBackToFront)
FAKE_RUNTIME(swift_arrayAssignWithCopyFrontToBack)
FAKE_RUNTIME(swift_arrayInitWithCopy)
FAKE_RUNTIME(swift_arrayInitWithTakeBackToFront)
FAKE_RUNTIME(swift_arrayInitWithTakeFrontToBack)
FAKE_RUNTIME(swift_allocateGenericValueMetadata)
FAKE_RUNTIME(swift_checkMetadataState)
FAKE_RUNTIME(swift_getExistentialTypeMetadata)
FAKE_RUNTIME(swift_getForeignTypeMetadata)
FAKE_RUNTIME(swift_getGenericMetadata)
FAKE_RUNTIME(swift_getTupleTypeLayout2)
FAKE_RUNTIME(swift_getTupleTypeMetadata2)
FAKE_RUNTIME(swift_initStructMetadata)
FAKE_RUNTIME(swift_dynamicCast)
FAKE_RUNTIME(swift_intToFloat32)
FAKE_RUNTIME(swift_getAssociatedConformanceWitness)
FAKE_RUNTIME(swift_getAssociatedTypeWitness)
FAKE_RUNTIME(swift_getWitnessTable)
FAKE_RUNTIME(swift_initEnumMetadataSinglePayload)
FAKE_RUNTIME(swift_registerProtocolConformances)
FAKE_RUNTIME(swift_conformsToProtocol)
FAKE_RUNTIME(swift_reportError)
FAKE_RUNTIME(swift_deletedMethodError)
FAKE_RUNTIME(swift_getTypeByMangledNameInContext)
FAKE_RUNTIME(swift_getTypeByMangledNameInContextInMetadataState)


// new in Swift 5.9 and Swift 5.11
