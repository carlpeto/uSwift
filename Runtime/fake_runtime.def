FAKE_RUNTIME(swift_getOpaqueTypeMetadata2)
FAKE_RUNTIME(swift_getOpaqueTypeConformance2)
FAKE_RUNTIME(swift_conformsToProtocol2)




#define EXPERIMENTAL_RUNTIME(fn) RUNTIME(fn) FAKE_RUNTIME(fn)


