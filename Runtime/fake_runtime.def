// these stubs are really only to prevent linker errors

// depending on the configuration linked, they can either
// do nothing or pass through to a noreturn function that
// blinks a telltale LED and hangs, so the developer knows
// unsupported runtime has been used
// for the passthrough case, all kinds of weird results may occur
// in a program that uses the stubs... they're set as void return
// so the program will be reading garbage for any return value
// and of course, the functions will do nothing, which will create
// all kinds of other bugs if called with an expectation

// to alleviate this, the current microswift compiler also
// reads this same file to get a list of functions that are
// unsupported runtime, and emits a compiler warning to tee
// up the developer early in the dev cycle that this must be
// addressed


FAKE_RUNTIME(_swift_isClassOrObjCExistentialType)
FAKE_RUNTIME(_swift_stdlib_getDefaultErrorCode)
FAKE_RUNTIME(swift_getErrorValue)
FAKE_RUNTIME(swift_isUniquelyReferenced_nonNull_native)
FAKE_RUNTIME(swift_isOptionalType)
FAKE_RUNTIME(swift_arrayAssignWithTake)
FAKE_RUNTIME(swift_arrayDestroy)
FAKE_RUNTIME(swift_getEnumCaseMultiPayload)
FAKE_RUNTIME(swift_initEnumMetadataMultiPayload)
FAKE_RUNTIME(swift_storeEnumTagMultiPayload)
FAKE_RUNTIME(_swift_makeAnyHashableUpcastingToHashableBaseType)

// These from Runtime.md in the swift/docs folder...

FAKE_RUNTIME(swift_bufferHeaderSize)

